{
  "name": "@pmf/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:core": "hardhat test test/core",
    "test:extensions": "hardhat test test/extensions",
    "test:fork:oracle": "hardhat test test/fork/PMFBasketOracle.fork.test.js",
    "test:fork:router": "hardhat test test/fork/FateDepositRouter.fork.test.js",
    "lint": "solhint 'contracts/**/*.sol'",
    "coverage": "hardhat coverage",
    "coverage:check": "hardhat coverage && node scripts/tooling/check-coverage.js",
    "security:slither": "hardhat compile --force && slither . --hardhat-ignore-compile --exclude timestamp --filter-paths 'node_modules|coverage|artifacts|cache' --fail-high",
    "export:vault-interface": "node scripts/tooling/export-pmf-vault-interface.js --out interfaces/current",
    "check:vault-interface": "node scripts/tooling/export-pmf-vault-interface.js --out interfaces/current --check",
    "check:pmvs-fixtures": "node scripts/tooling/validate-pmvs-extension-fixtures.js",
    "verify:export-manifest": "node scripts/tooling/verify-export-manifest.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "hardhat": "^2.22.0",
    "solhint": "^5.0.0",
    "solidity-coverage": "^0.8.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PMF-Finance/protocol.git"
  },
  "homepage": "https://github.com/PMF-Finance/protocol#readme",
  "bugs": {
    "url": "https://github.com/PMF-Finance/protocol/issues"
  }
}
